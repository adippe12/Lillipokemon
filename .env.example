# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL of the always-on chat listener Worker (ops/listener/, see scripts/deploy_listener.sh).
# Leave unset to hide the "24/7 LISTENER" status pill on the home page.
# NEXT_PUBLIC_LISTENER_URL=https://lillipokemon-listener.<your-subdomain>.workers.dev

# The admin account is created in Supabase Auth (Dashboard -> Authentication),
# then allow-listed with:  insert into admins (email) values ('the-email');
